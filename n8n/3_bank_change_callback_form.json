                  },
                  {
                    "option": "V002"
                  },
                  {
                    "option": "V003"
                  },
                  {
                    "option": "V004"
                  },
                  {
                    "option": "V005"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Phone number called",
              "placeholder": "+91-...",
              "requiredField": true
            },
            {
              "fieldLabel": "Person spoken to",
              "requiredField": true
            },
            {
              "fieldLabel": "Did the vendor confirm they asked for the change?",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Verified by",
              "requiredField": true
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "bank-change-callback"
        }
      },
      "id": "1cd82896-9a7d-5d75-972a-0aad63449806",
      "name": "Call-back form (Vendor Master team)",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "webhookId": "9c2d4e6f-1a3b-4c5d-8e7f-0a1b2c3d4e5f"
    },
    {
      "parameters": {
        "jsCode": "// Compares the call-back with the phone number ON FILE in the vendor's contract\n// (the same numbers the ProcureGuard knowledge base holds in knowledge_base/contracts/).\nconst ON_FILE = {\n  V001: { phone: '+91-124-400-1101', contact: 'Anil Shree' },\n  V002: { phone: '+91-11-4055-0182', contact: 'Rajesh Mehta' },\n  V003: { phone: '+91-124-466-2290', contact: 'Priya Nair' },\n  V004: { phone: '+91-120-455-7710', contact: 'Sandeep Rawat' },\n  V005: { phone: '+91-124-410-3302', contact: 'Vikram Sethi' },\n};\nconst f = $input.first().json;\nconst digits = s => String(s || '').replace(/\\D/g, '');\nconst vendor = f['Vendor'];\nconst file = ON_FILE[vendor] || {};\nconst reasons = [];\nif (digits(f['Phone number called']) !== digits(file.phone)) {\n  reasons.push(`Number called (${f['Phone number called']}) is not the number on file (${file.phone}). A number supplied in the change request may belong to the fraudster.`);\n}\nif (!String(f['Person spoken to']).toLowerCase().includes(String(file.contact || '').split(' ').pop().toLowerCase())) {\n  reasons.push(`Person spoken to is not the authorised contact on file (${file.contact}).`);\n}\nif (f['Did the vendor confirm they asked for the change?'] !== 'Yes') {\n  reasons.push('The authorised contact did NOT confirm the bank change request.');\n}\nconst verified = reasons.length === 0;\nreturn [{ json: {\n  vendor_id: vendor, phone_called: f['Phone number called'], phone_on_file: file.phone || 'not on file',\n  person_spoken_to: f['Person spoken to'], vendor_confirmed: f['Did the vendor confirm they asked for the change?'],\n  verified_by: f['Verified by'], verified, result: verified ? 'VERIFIED' : 'FAILED',\n  reasons: reasons.join(' ') || 'All checks passed',\n} }];"
      },
      "id": "bbe0329d-3a94-515d-a8f0-f2d1e6a8a847",
      "name": "Check against phone on file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
