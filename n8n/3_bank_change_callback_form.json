            "vendor_confirmed": "={{ $json.vendor_confirmed }}",
            "result": "={{ $json.result }}",
            "reasons": "={{ $json.reasons }}",
            "verified_by": "={{ $json.verified_by }}"
          },
          "matchingColumns": [],
