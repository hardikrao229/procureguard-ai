# Copy this file, rename the copy to .env, and paste your key after the = sign.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Model to use. If you get quota errors, try gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Optional: n8n webhook for follow-up automation (see the n8n/ folder).
# Without it, events are kept in logs/n8n_outbox.jsonl and shown in the Automation tab.
N8N_WEBHOOK_URL=
